<Project>

  <!--
    Central package management. Every version lives here and nowhere else, so a
    dependency cannot drift per project. Section 13 requires the identity and
    broker packages in particular to be centrally pinned, because the provider's
    silent-only broker construction is validated against specific versions during
    Phase 0 and an unnoticed bump would invalidate that evidence.

    Versions resolved against nuget.org on 2026-07-28.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Windows App SDK">
    <!--
      Stable channel only, per section 13. Preview and Experimental packages are
      prohibited. 2.3.1 is the version the plan pins and the version whose
      runtime (Microsoft.WindowsAppRuntime.2 2.3.1.0) is already present on the
      reference machine.
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup Label="Authentication">
    <!--
      MSAL plus the brokered-authentication package. The companion uses a real
      HWND and interactive acquisition; the provider uses the same broker package
      with a zero parent handle and silent acquisition only.
    -->
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.87.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Broker" Version="4.87.0" />

    <!--
      The cross-platform token cache, and NOT an optional convenience.

      Current Microsoft documentation states that MSAL "continues to store ID tokens
      and account metadata" in its own cache even when the broker holds the refresh
      token, and that without persisting it "restarting the app means that
      GetAccounts API will miss some of the accounts". The companion signs in and the
      provider acquires silently in a *different process*, so an in-memory cache would
      leave the provider unable to find the account the companion just added — gate 9
      would fail for a reason that has nothing to do with the zero window handle it
      exists to test.

      The alternative was a hand-rolled DPAPI file with a process-local lock, which is
      what the MSAL documentation itself labels a naive implementation. Two processes
      share this file, so the cross-process locking in the first-party helper is the
      whole reason to take the dependency rather than write twenty lines.

      Pinned to the same 4.87.0 as MSAL: the extension and the core library share cache
      format assumptions, and a split version pair is not a combination Microsoft tests.
    -->
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.87.0" />
  </ItemGroup>

  <ItemGroup Label="Platform">
    <!-- Windows DPAPI, CurrentUser scope, for the protected snapshot. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
