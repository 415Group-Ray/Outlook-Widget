<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>OutlookWidget.Core.Tests</RootNamespace>
    <AssemblyName>OutlookWidget.Core.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OutlookWidget.Core\OutlookWidget.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The static-analysis tests read the product's own source, so they need its path at
      runtime rather than a copy of the compiled output.
    -->
    <AssemblyMetadata Include="CoreSourceDirectory"
                      Value="$(MSBuildThisFileDirectory)..\..\src\OutlookWidget.Core" />
    <AssemblyMetadata Include="SourceRootDirectory"
                      Value="$(MSBuildThisFileDirectory)..\.." />

    <!--
      The provider and the package manifest are read as source rather than referenced.

      A ProjectReference is not possible without also moving this project to the provider's
      Windows-SDK-versioned target framework, which would pull the Windows App SDK projections
      into the test host for every existing test. The invariants that matter most here — one
      UpdateWidget call site, no interactive authentication reachable from the provider, and three
      copies of one CLSID agreeing — are edit-time properties of the source and the manifest, so
      reading them is not a weaker check than referencing would be. Behavioural provider tests
      arrive with the framework change when there is provider behaviour worth exercising.
    -->
    <AssemblyMetadata Include="ProviderSourceDirectory"
                      Value="$(MSBuildThisFileDirectory)..\..\src\OutlookWidget.Provider" />
    <AssemblyMetadata Include="PackageManifestPath"
                      Value="$(MSBuildThisFileDirectory)..\..\src\OutlookWidget.Package\Package.appxmanifest" />
    <AssemblyMetadata Include="PackageAssetsDirectory"
                      Value="$(MSBuildThisFileDirectory)..\..\src\OutlookWidget.Package\Assets" />
  </ItemGroup>

</Project>
