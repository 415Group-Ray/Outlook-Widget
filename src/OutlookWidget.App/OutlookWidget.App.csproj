<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Deliberately NOT a WinUI 3 project yet.

      Phase 0's gate 1 asks one question: does a signed MSIX install on this Entra-managed PC,
      and can the certificate be trusted there? That question is about signing, packaging, and
      device policy. Bringing WinUI in now would add a framework dependency, a runtime
      requirement, and an XAML toolchain to the very first thing being tested, so a failure
      would be ambiguous between "sideloading is blocked" and "the app does not start".

      Phase 2 owns the companion experience and converts this into the real WinUI 3 app. Until
      then this is the smallest thing that can be packaged, launched, and observed.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OutlookWidget.App</RootNamespace>
    <AssemblyName>OutlookWidget.App</AssemblyName>

    <!-- Trimming and single-file are packaging concerns and stay off while identity is settled. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>

    <!--
      Required by LibraryImport, whose generated string marshalling is pointer-based, and by
      CompanionWindow, which passes its window procedure as a function pointer rather than a
      marshalled delegate so there is no delegate lifetime to get wrong. The package-identity interop
      moved to OutlookWidget.Packaging so the companion and the provider share one copy.

      OutlookWidget.Core has no unsafe code and must not acquire any.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      MSAL is referenced explicitly rather than taken transitively through the core. This project
      owns the single interactive acquisition call site, so its dependency on the authentication
      library is a real one and should be visible here.

      Microsoft.Identity.Client.Broker and .Extensions.Msal are deliberately NOT referenced: broker
      configuration and the token cache belong to the core, which both executables share.
    -->
    <PackageReference Include="Microsoft.Identity.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutlookWidget.Core\OutlookWidget.Core.csproj" />
    <ProjectReference Include="..\OutlookWidget.Packaging\OutlookWidget.Packaging.csproj" />
  </ItemGroup>

</Project>
