<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinUI 3 is the approved Phase 2 companion surface. The Windows SDK floor matches the
         package manifest and the provider so compile-time API availability cannot drift from the
         platform the package declares. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OutlookWidget.App</RootNamespace>
    <AssemblyName>OutlookWidget.App</AssemblyName>
    <UseWinUI>true</UseWinUI>

    <!-- WinUI generates a Main method by default. This app supplies its own so AppInstance can
         redirect a second activation before a second window or any coordination state is opened. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Trimming and single-file are packaging concerns and stay off while identity is settled. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>false</SelfContained>

    <!--
      Required by the small blittable interop surface used by single-instance activation redirection.
      Package-identity interop remains in OutlookWidget.Packaging so the companion and provider share
      one copy.

      OutlookWidget.Core has no unsafe code and must not acquire any.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      MSAL is referenced explicitly rather than taken transitively through the core. This project
      owns the single interactive acquisition call site, so its dependency on the authentication
      library is a real one and should be visible here.

      Microsoft.Identity.Client.Broker and .Extensions.Msal are deliberately NOT referenced: broker
      configuration and the token cache belong to the core, which both executables share.
    -->
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutlookWidget.Core\OutlookWidget.Core.csproj" />
    <ProjectReference Include="..\OutlookWidget.Packaging\OutlookWidget.Packaging.csproj" />
  </ItemGroup>

</Project>
