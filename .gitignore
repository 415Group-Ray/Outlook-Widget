# Build output. These may still sync through OneDrive, which section 12 accepts
# unless Phase 0 produces evidence of recurring contention. What matters here is
# that they never enter Git.
[Bb]in/
[Oo]bj/
[Oo]ut/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# MSIX packaging output
AppPackages/
BundleArtifacts/

# The derived package-version counter. Local build state, not a shared decision: it records how many
# times THIS machine has packaged the current commit. Committing it would produce merge conflicts on a
# value nobody reads and would not help another clone, which consults the installed package instead.
.package-version.json
*.appx
*.msix
*.msixbundle
*.appxbundle
*.appxupload
*.msixupload
*.cer

# Signing key material must never be in the repository or in OneDrive. These
# patterns are a backstop, not the control: the private key belongs in
# CurrentUser\My or a dedicated non-synced path, and Test-PackagePrerequisites.ps1
# fails the preflight if any key file appears under the repository root.
*.pfx
*.p12
*.snk
*.key

# Test and coverage output
TestResults/
[Cc]overage/
*.coverage
*.coveragexml
*.trx

# NuGet
*.nupkg
*.snupkg
packages/
!nuget.config

# Local configuration that is machine-specific rather than shared
appsettings.Local.json
*.local.props

# Entra registration identifiers. Not secrets - both appear in ordinary network requests - but a
# committed development value is the one most likely to be aimed at the wrong environment by
# accident. The committed authentication.template.json carries placeholder zeros, and the loader
# rejects those, so a package built without real values fails closed rather than authenticating
# against a nonexistent registration.
authentication.local.json
authentication.json

# Graphify's shared graph, report, HTML, manifest, labels, and cost history stay
# versioned. Interpreter selection, extraction caches, query/session memory, and
# dated local snapshots are machine-local or reproducible and only create churn.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.vocab.txt
graphify-out/.graphify_learning.json
graphify-out/cache/
graphify-out/memory/
graphify-out/reflections/
graphify-out/20??-??-??/

# OS and editor noise
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
*.swp
