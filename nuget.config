<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repository-scoped NuGet configuration.

    clear removes any machine or user level feed so a restore here depends only
    on the sources listed below. Without it, a feed configured elsewhere on the
    machine could silently satisfy a package reference, which is exactly the
    ambiguity central pinning exists to remove.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Package source mapping. With a single approved feed the only honest mapping
    is everything to that feed; the value is that adding a second feed later
    forces an explicit decision about which packages may come from it rather
    than leaving both feeds racing to resolve every reference.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <!-- Keep the restore cache out of the repository and out of OneDrive. -->
    <add key="globalPackagesFolder" value="%UserProfile%\.nuget\packages" />
  </config>

  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
</configuration>
